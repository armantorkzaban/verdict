    { "id": "B0", "label": "Stock Postgres + PgBouncer", "description": "Connection pooling only, no query cache" },
    { "id": "B1", "label": "Tuned Redis + application read-aside", "description": "Standard open-source TTL + invalidation setup" }
  ],
  "questions": [
