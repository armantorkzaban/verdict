    { "id": "E2", "rank": 2, "description": "Replay on production SQL traces from public/anonymized workloads" },
    { "id": "E3", "rank": 3, "description": "Shadow-mode or switchback pilot on live database traffic" },
    { "id": "E4", "rank": 4, "description": "Production holdout at a design partner" },
    { "id": "E5", "rank": 5, "description": "Paying customer, renewed" }
  ],
  "rules": {
    "causal_floor": "E3",
